# Generate a local ingestion token using: docker compose run --rm checker python -m car_space_checker init-token
CHECKER_PORT=8099
CHECKER_TOKEN=
CHECKER_ID=parking_poc
# Optional. Leave empty to test images without connecting to Home Assistant.
MQTT_HOST=
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
